# Optional; only required for live mode. Do not commit a filled copy.
AGENT_MODE=replay
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=


# 与 Java 副本的 FORENSIC_AGENT_TOKEN 相同；不配置就关闭桥接。
AGENT_BRIDGE_TOKEN=

# Optional alternative to AGENT_API_KEY / AGENT_BASE_URL / AGENT_MODEL.
# AGENT_JAVA_CONFIG=E:/path/to/your-local-java-config.yaml

# Optional: only public/synthetic audit traces are sent to LangSmith.
AGENT_LANGSMITH_DEMO=false
LANGSMITH_PROJECT=forensic-agent-lab
# LANGSMITH_API_KEY=
